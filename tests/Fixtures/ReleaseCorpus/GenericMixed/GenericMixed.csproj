<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Fixture.GenericMixed</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>fixture;nuget;generic;forwarder</PackageTags>
    <RepositoryUrl>https://github.com/KeelMatrix/NuGetReady</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fixture.GenericImplementation" VersionOverride="1.0.0" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../../icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
</Project>
